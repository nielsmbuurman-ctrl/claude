{%- if section.blocks.size > 0 -%}
  <announcement-bar class="announce" data-interval="{{ section.settings.interval }}" {{ section.shopify_attributes }}>
    <div class="announce__track" aria-live="polite">
      {%- for block in section.blocks -%}
        <p class="announce__msg{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
          {%- else -%}
            {{ block.settings.text }}
          {%- endif -%}
        </p>
      {%- endfor -%}
    </div>
  </announcement-bar>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "tag": "div",
  "class": "section-announce",
  "settings": [
    { "type": "range", "id": "interval", "label": "Seconds per message", "min": 3, "max": 10, "step": 1, "default": 4 }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "€19,95 per bril · elke extra bril €15" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "Announcement bar", "blocks": [{ "type": "message" }] }]
}
{% endschema %}
