{%- liquid
  assign gift_from = settings.gift_from_pairs
  assign ship_money = settings.single_shipping_price | times: 100 | round | money
-%}
<section class="tiers-section page-width">
  {%- if section.settings.heading != blank -%}<h2 class="h2 tiers-section__heading">{{ section.settings.heading }}</h2>{%- endif -%}
  <ol class="tier-cards" role="list">
    {%- for n in (1..3) -%}
      {%- liquid
        case n
          when 1
            assign name = section.settings.name_1
            assign badge = ''
          when 2
            assign name = section.settings.name_2
            assign badge = section.settings.badge_2
          when 3
            assign name = section.settings.name_3
            assign badge = section.settings.badge_3
        endcase
      -%}
      <li class="tier-card{% if n == 2 %} tier-card--featured{% endif %}">
        <p class="tier-card__top">
          <span class="label">{{ name }}</span>
          {%- if badge != blank -%}<span class="badge">{{ badge }}</span>{%- endif -%}
        </p>
        <p class="tier-card__price">{% render 'set-price', pairs: n %}</p>
        <p class="tier-card__note">
          {%- if n == 1 -%}
            {{ 'sets.shipping_price' | t: price: ship_money }}
          {%- else -%}
            {%- capture per -%}{% render 'set-price', pairs: n, per_pair: true %}{%- endcapture -%}
            {{ 'sets.per_pair' | t: price: per }} · {{ 'sets.free_shipping' | t }}
            {%- if n >= gift_from and settings.gift_product != blank %} · {{ 'sets.free_gift' | t }}{% endif -%}
          {%- endif -%}
        </p>
      </li>
    {%- endfor -%}
  </ol>
  {%- if section.settings.button_label != blank -%}
    <div class="section-foot"><a class="btn" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a></div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Set prices",
  "tag": "div",
  "class": "section-tiers",
  "settings": [
    { "type": "paragraph", "content": "Prices come from Theme settings > Sets & prices." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Eén voor jou. Eén voor wie er naast je staat." },
    { "type": "text", "id": "name_1", "label": "Name, 1 pair", "default": "1 bril" },
    { "type": "text", "id": "name_2", "label": "Name, 2 pairs", "default": "Duo" },
    { "type": "text", "id": "badge_2", "label": "Badge, 2 pairs", "default": "Meest gekozen" },
    { "type": "text", "id": "name_3", "label": "Name, 3 pairs", "default": "Crew" },
    { "type": "text", "id": "badge_3", "label": "Badge, 3 pairs", "default": "Beste deal" },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Stel je set samen" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Set prices" }]
}
{% endschema %}
