<section class="callout callout--{{ section.settings.style }}">
  <div class="callout__inner page-width">
    <h2 class="h2 callout__heading">{{ section.settings.heading }}</h2>
    <div class="callout__body">
      {%- if section.settings.text != blank -%}<p class="callout__text">{{ section.settings.text }}</p>{%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a class="btn" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Callout",
  "tag": "div",
  "class": "section-callout",
  "settings": [
    { "type": "select", "id": "style", "label": "Background", "options": [{ "value": "tile", "label": "Tile" }, { "value": "plain", "label": "Plain" }, { "value": "ink", "label": "Dark" }], "default": "tile" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Welke bril is van jou?" },
    { "type": "text", "id": "text", "label": "Text", "default": "Drie vragen. Twintig seconden. Twee matches." },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Vind mijn bril" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Callout" }]
}
{% endschema %}
