<cart-drawer class="cart-drawer" data-cart-section="{{ section.id }}">
  <dialog class="drawer" aria-labelledby="CartDrawerTitle">
    <div class="drawer__head">
      <h2 id="CartDrawerTitle" class="drawer__title">
        {{ 'cart.title' | t }}{% if cart.item_count > 0 %} <span class="drawer__count">({{ cart.item_count }})</span>{% endif %}
      </h2>
      <button type="button" class="icon-btn" data-close aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button>
    </div>
    <div class="drawer__body" data-cart-content data-count="{{ cart.item_count }}">
      {% render 'cart-contents', context: 'drawer' %}
    </div>
  </dialog>
</cart-drawer>

{% schema %}
{
  "name": "Cart drawer",
  "tag": "div",
  "class": "section-cart-drawer",
  "settings": []
}
{% endschema %}
