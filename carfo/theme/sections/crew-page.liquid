<section class="crew page-width">
  <div class="crew__hero">
    <p class="label">{{ section.settings.eyebrow }}</p>
    <h1 class="display">{{ section.settings.heading }}</h1>
    <p class="crew__intro">{{ section.settings.text }}</p>
    {%- if section.settings.button_link != blank -%}
      <a class="btn" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
    {%- endif -%}
  </div>

  {%- assign perks = section.blocks | where: 'type', 'perk' -%}
  {%- if perks.size > 0 -%}
    <ul class="crew__perks" role="list">
      {%- for block in perks -%}
        <li class="perk" {{ block.shopify_attributes }}>
          <p class="perk__big">{{ block.settings.big }}</p>
          <p>{{ block.settings.text }}</p>
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}

  {%- assign steps = section.blocks | where: 'type', 'step' -%}
  {%- if steps.size > 0 -%}
    <div class="crew__steps">
      <h2 class="h2">{{ section.settings.steps_heading }}</h2>
      <ol class="steps" role="list">
        {%- for block in steps -%}
          <li class="step" {{ block.shopify_attributes }}><span class="step__n">{{ forloop.index }}</span><span>{{ block.settings.text }}</span></li>
        {%- endfor -%}
      </ol>
    </div>
  {%- endif -%}

  {%- assign questions = section.blocks | where: 'type', 'question' -%}
  {%- if questions.size > 0 -%}
    <div class="crew__faq page-width--narrow">
      {%- for block in questions -%}
        <details class="accordion" {{ block.shopify_attributes }}>
          <summary class="accordion__summary">{{ block.settings.question }}{% render 'icon', name: 'plus' %}</summary>
          <div class="accordion__content rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- if section.settings.button_link != blank -%}
    <div class="section-foot"><a class="btn" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a></div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Join the crew",
  "tag": "div",
  "class": "section-crew",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Join the crew" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Draag 'm. Deel 'm. Verdien eraan." },
    { "type": "text", "id": "text", "label": "Text", "default": "Gratis aanmelden. Geen minimum aantal volgers." },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Meld je aan" },
    { "type": "url", "id": "button_link", "label": "Sign-up link", "info": "The sign-up page of your affiliate app." },
    { "type": "text", "id": "steps_heading", "label": "Steps heading", "default": "Zo werkt het" }
  ],
  "blocks": [
    {
      "type": "perk",
      "name": "Perk",
      "settings": [
        { "type": "text", "id": "big", "label": "Big text", "default": "10%" },
        { "type": "text", "id": "text", "label": "Text", "default": "commissie op elke bestelling met jouw code." }
      ]
    },
    {
      "type": "step",
      "name": "Step",
      "settings": [{ "type": "text", "id": "text", "label": "Text", "default": "Meld je aan in 5 minuten." }]
    },
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Wanneer word ik betaald?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Commissie wordt uitbetaald zodra de retourtermijn van 30 dagen voorbij is.</p>" }
      ]
    }
  ],
  "presets": [{ "name": "Join the crew" }]
}
{% endschema %}
