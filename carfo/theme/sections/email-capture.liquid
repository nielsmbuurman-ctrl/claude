<section class="signup">
  <div class="signup__inner page-width">
    <div class="signup__text">
      <h2 class="h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
    </div>
    {%- form 'customer', id: 'SignupForm', class: 'signup__form' -%}
      {%- if form.posted_successfully? -%}
        <p class="signup__success" role="status">{% render 'icon', name: 'check' %} {{ section.settings.success }}</p>
      {%- else -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="inline-form">
          <label class="visually-hidden" for="SignupEmail-{{ section.id }}">{{ 'newsletter.email' | t }}</label>
          <input id="SignupEmail-{{ section.id }}" class="field" type="email" name="contact[email]" autocomplete="email" required placeholder="{{ 'newsletter.email' | t }}">
          <button class="btn" type="submit">{{ section.settings.button }}</button>
        </div>
        {%- if form.errors -%}
          <p class="form-error" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
        {%- endif -%}
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Email signup",
  "tag": "div",
  "class": "section-signup",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Als eerste bij nieuwe brillen." },
    { "type": "text", "id": "text", "label": "Text", "default": "Plus een gratis koord bij je eerste bestelling. Alleen drops, geen spam." },
    { "type": "text", "id": "button", "label": "Button", "default": "Ik doe mee" },
    { "type": "text", "id": "success", "label": "Success message", "default": "Je staat erop. Check je inbox." }
  ],
  "presets": [{ "name": "Email signup" }]
}
{% endschema %}
