<section class="faq page-width page-width--narrow">
  {%- if section.settings.heading != blank -%}<h2 class="h2 faq__heading">{{ section.settings.heading }}</h2>{%- endif -%}
  <div class="faq__list">
    {%- for block in section.blocks -%}
      <details class="accordion" {{ block.shopify_attributes }}>
        <summary class="accordion__summary">{{ block.settings.question }}{% render 'icon', name: 'plus' %}</summary>
        <div class="accordion__content rte">{{ block.settings.answer }}</div>
      </details>
    {%- endfor -%}
  </div>
</section>

{%- if section.blocks.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in section.blocks -%}
          {
            "@type": "Question",
            "name": {{ block.settings.question | json }},
            "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "FAQ",
  "tag": "div",
  "class": "section-faq",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Vragen" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Past hij op mijn gezicht?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Elke bril vermeldt zijn breedte in millimeters en een pasvorm (smal, medium, breed).</p>" }
      ]
    }
  ],
  "presets": [{ "name": "FAQ", "blocks": [{ "type": "question" }] }]
}
{% endschema %}
