<footer class="footer">
  <div class="page-width">
    <div class="footer__top">
      <a class="footer__brand" href="{{ routes.root_url }}"><span class="wordmark">{{ settings.wordmark | default: shop.name }}</span></a>
      {%- if section.settings.tagline != blank -%}
        <p class="footer__tagline">{{ section.settings.tagline }}</p>
      {%- endif -%}
    </div>

    <div class="footer__cols">
      {%- for block in section.blocks -%}
        <div class="footer__col" {{ block.shopify_attributes }}>
          {%- if block.settings.heading != blank -%}
            <h2 class="footer__heading">{{ block.settings.heading }}</h2>
          {%- endif -%}
          {%- case block.type -%}
            {%- when 'menu' -%}
              <ul class="footer__links" role="list">
                {%- for link in block.settings.menu.links -%}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {%- endfor -%}
              </ul>
            {%- when 'text' -%}
              <div class="rte footer__text">{{ block.settings.text }}</div>
          {%- endcase -%}
        </div>
      {%- endfor -%}
    </div>

    <div class="footer__bottom">
      <div class="footer__company">
        <p>
          &copy; {{ 'now' | date: '%Y' }} {{ settings.company_name | default: shop.name }}
          {%- if settings.company_kvk != blank %} · {{ 'footer.kvk' | t }} {{ settings.company_kvk }}{% endif -%}
          {%- if settings.company_vat != blank %} · {{ 'footer.vat' | t }} {{ settings.company_vat }}{% endif -%}
        </p>
        {%- if settings.company_address != blank or settings.company_email != blank -%}
          <p>
            {{- settings.company_address | newline_to_br -}}
            {%- if settings.company_email != blank %} · <a href="mailto:{{ settings.company_email }}">{{ settings.company_email }}</a>{% endif -%}
          </p>
        {%- endif -%}
      </div>

      <div class="footer__end">
        {%- if settings.social_instagram != blank or settings.social_tiktok != blank -%}
          <ul class="footer__social" role="list">
            {%- if settings.social_instagram != blank -%}
              <li><a class="icon-btn" href="{{ settings.social_instagram }}" aria-label="Instagram">{% render 'icon', name: 'instagram' %}</a></li>
            {%- endif -%}
            {%- if settings.social_tiktok != blank -%}
              <li><a class="icon-btn" href="{{ settings.social_tiktok }}" aria-label="TikTok">{% render 'icon', name: 'tiktok' %}</a></li>
            {%- endif -%}
          </ul>
        {%- endif -%}

        {%- if localization.available_languages.size > 1 -%}
          {%- form 'localization', class: 'footer__lang' -%}
            <label class="visually-hidden" for="FooterLanguage">{{ 'footer.language' | t }}</label>
            <select id="FooterLanguage" name="locale_code" data-autosubmit>
              {%- for language in localization.available_languages -%}
                <option value="{{ language.iso_code }}"{% if language.iso_code == localization.language.iso_code %} selected{% endif %}>{{ language.iso_code | upcase }}</option>
              {%- endfor -%}
            </select>
            <noscript><button type="submit">OK</button></noscript>
          {%- endform -%}
        {%- endif -%}

        {%- if section.settings.show_payment_icons -%}
          <ul class="payment-icons" role="list">
            {%- for type in shop.enabled_payment_types -%}
              <li>{{ type | payment_type_svg_tag: class: 'payment-icon' }}</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "tag": "div",
  "class": "section-footer",
  "settings": [
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "Tien brillen. Geen opvullers." },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Show payment icons", "default": true }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Carfo" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>UV400-zonnebrillen. €19,95 per bril, elke extra bril €15.</p>" }
      ]
    }
  ],
  "max_blocks": 4
}
{% endschema %}
