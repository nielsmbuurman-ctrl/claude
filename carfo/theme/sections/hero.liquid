{%- liquid
  assign img = section.settings.image
  assign img_m = section.settings.image_mobile | default: img
  assign frames = settings.frames_collection | default: collections.all
  assign sketch_tint = frames.products.first.metafields.carfo.tint_hex.value | default: '#8FC3E4'
-%}
<section class="hero hero--{{ section.settings.height }}{% if img == blank %} hero--no-image{% endif %} hero--text-{{ section.settings.text_color }}">
  <div class="hero__media">
    {%- if img != blank -%}
      <picture>
        <source media="(max-width: 749px)" srcset="{{ img_m | image_url: width: 750 }} 750w, {{ img_m | image_url: width: 1100 }} 1100w" sizes="100vw">
        {{ img | image_url: width: 2400 | image_tag: widths: '1000, 1400, 1800, 2400', sizes: '100vw', loading: 'eager', fetchpriority: 'high', class: 'hero__img', alt: img.alt }}
      </picture>
      {%- if section.settings.overlay > 0 -%}
        <span class="hero__overlay" style="opacity: {{ section.settings.overlay | divided_by: 100.0 }}"></span>
      {%- endif -%}
    {%- else -%}
      <div class="hero__sketch">
        {% render 'frame-sketch', tint: sketch_tint, alpha: 0.5, label: shop.name %}
      </div>
    {%- endif -%}
  </div>
  <div class="hero__content page-width">
    {%- if section.settings.eyebrow != blank -%}<p class="label hero__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2 class="display hero__heading">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.text != blank -%}<p class="hero__text">{{ section.settings.text }}</p>{%- endif -%}
    <div class="hero__actions">
      {%- if section.settings.button_label != blank -%}
        <a class="btn{% if section.settings.text_color == 'light' and img != blank %} btn--light{% endif %}" href="{{ section.settings.button_link | default: frames.url }}">{{ section.settings.button_label }}</a>
      {%- endif -%}
      {%- if section.settings.link_label != blank -%}
        <a class="text-link" href="{{ section.settings.link_url }}">{{ section.settings.link_label }} {% render 'icon', name: 'arrow' %}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "tag": "div",
  "class": "section-hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image", "info": "One model, hard sun, one frame. 2400 px wide." },
    { "type": "image_picker", "id": "image_mobile", "label": "Mobile image", "info": "Portrait, 4:5. Optional." },
    { "type": "range", "id": "overlay", "label": "Darken image", "min": 0, "max": 60, "step": 5, "unit": "%", "default": 15 },
    { "type": "select", "id": "text_color", "label": "Text colour", "options": [{ "value": "light", "label": "Light" }, { "value": "dark", "label": "Dark" }], "default": "light" },
    { "type": "select", "id": "height", "label": "Height", "options": [{ "value": "full", "label": "Full screen" }, { "value": "large", "label": "Large" }], "default": "full" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Carfo · 10 brillen" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Tien brillen. Geen opvullers." },
    { "type": "text", "id": "text", "label": "Text", "default": "UV400-zonnebrillen voor €19,95. Elke extra bril €15." },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Bekijk alle 10" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Empty = the frames collection" },
    { "type": "text", "id": "link_label", "label": "Second link", "default": "Stel je set samen" },
    { "type": "url", "id": "link_url", "label": "Second link URL" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
