{%- liquid
  assign frames = settings.frames_collection | default: collections.all
  assign single = false
  if section.settings.mode == 'current' and product
    assign single = true
  endif
-%}
<section class="loupe-section page-width">
  <div class="section-head">
    <div>
      {%- if section.settings.heading != blank -%}
        <h2 class="h2">{% if single %}{{ section.settings.heading_single | replace: '[frame]', product.title }}{% else %}{{ section.settings.heading }}{% endif %}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}<p class="section-head__text">{{ section.settings.text }}</p>{%- endif -%}
    </div>
  </div>

  <lens-loupe class="loupe">
    <div class="loupe__stage" data-stage>
      {%- if section.settings.scene != blank -%}
        {{ section.settings.scene | image_url: width: 2000 | image_tag: loading: 'lazy', widths: '800, 1200, 1600, 2000', sizes: '(min-width: 1200px) 1200px, 100vw', class: 'loupe__scene', alt: section.settings.scene.alt }}
      {%- else -%}
        <div class="loupe__scene loupe__scene--fallback" role="img" aria-label="{{ 'loupe.fallback_scene' | t }}"></div>
      {%- endif -%}
      <div class="loupe__tint" data-tint aria-hidden="true"></div>
      <svg class="loupe__frame" data-frame viewBox="0 0 600 260" aria-hidden="true" focusable="false">
        <g fill="none" stroke="currentColor" stroke-width="12" stroke-linejoin="round" stroke-linecap="round">
          <rect x="62" y="66" width="208" height="140" rx="40"/>
          <rect x="330" y="66" width="208" height="140" rx="40"/>
          <path d="M270 104c18-16 42-16 60 0"/>
          <path d="M62 92H22M538 92h40"/>
        </g>
      </svg>
      <p class="loupe__hint label" aria-hidden="true">{{ 'loupe.hint' | t }}</p>
    </div>

    {%- if single -%}
      {%- assign m = product.metafields.carfo -%}
      <div hidden data-swatch data-tint="{{ m.tint_hex.value | default: '#2B2B30' }}" data-alpha="{{ m.tint_alpha.value | default: 0.5 }}" data-frame-color="{{ m.frame_hex.value | default: '#111111' }}"></div>
    {%- else -%}
      <div class="loupe__swatches" role="radiogroup" aria-label="{{ 'loupe.choose' | t }}">
        {%- for p in frames.products limit: 12 -%}
          {%- assign m = p.metafields.carfo -%}
          <button
            type="button"
            class="swatch"
            role="radio"
            aria-checked="{% if forloop.first %}true{% else %}false{% endif %}"
            tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
            data-swatch
            data-tint="{{ m.tint_hex.value | default: '#2B2B30' }}"
            data-alpha="{{ m.tint_alpha.value | default: 0.5 }}"
            data-frame-color="{{ m.frame_hex.value | default: '#111111' }}"
            data-caption="{{ p.title | escape }}{% if m.colourway != blank %} · {{ m.colourway.value | escape }}{% endif %}"
            data-url="{{ p.url }}"
          >
            <span class="swatch__dot" style="--swatch: {{ m.tint_hex.value | default: '#2B2B30' }}"></span>
            <span class="swatch__name">{{ p.title }}</span>
          </button>
        {%- endfor -%}
      </div>
      <p class="loupe__caption" aria-live="polite"><a data-caption href="{{ frames.products.first.url }}"></a></p>
    {%- endif -%}
  </lens-loupe>
</section>

{% schema %}
{
  "name": "See through the lens",
  "tag": "div",
  "class": "section-loupe",
  "settings": [
    {
      "type": "select",
      "id": "mode",
      "label": "Lenses",
      "options": [{ "value": "all", "label": "All frames (swatches)" }, { "value": "current", "label": "Only this frame (product pages)" }],
      "default": "all"
    },
    { "type": "image_picker", "id": "scene", "label": "Scene photo", "info": "A bright summer scene, 16:10. Festival, beach or street." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Zie het voor je hem draagt." },
    { "type": "text", "id": "heading_single", "label": "Heading on product pages", "default": "Kijk door [frame].", "info": "[frame] becomes the frame's name." },
    { "type": "text", "id": "text", "label": "Text", "default": "Beweeg over de foto om door elk glas te kijken." }
  ],
  "presets": [{ "name": "See through the lens" }]
}
{% endschema %}
