<article class="page-width page-width--narrow article">
  <p class="label">{{ article.published_at | time_tag: format: 'date' }}</p>
  <h1 class="h1">{{ article.title }}</h1>
  {%- if article.image -%}
    <div class="article__image">
      {{ article.image | image_url: width: 1600 | image_tag: widths: '600, 900, 1200, 1600', sizes: '(min-width: 990px) 720px, 100vw', alt: article.image.alt }}
    </div>
  {%- endif -%}
  <div class="rte">{{ article.content }}</div>
</article>

<script type="application/ld+json">
  {{ article | structured_data }}
</script>

{% schema %}
{
  "name": "Article",
  "tag": "div",
  "settings": []
}
{% endschema %}
