<section class="page-width blog">
  <h1 class="h1 page-title">{{ blog.title }}</h1>
  {%- paginate blog.articles by 12 -%}
    <ul class="blog__list" role="list">
      {%- for article in blog.articles -%}
        <li class="blog__item">
          <a href="{{ article.url }}" class="blog__link">
            {%- if article.image -%}
              {{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 990px) 33vw, 100vw', alt: article.image.alt }}
            {%- endif -%}
            <span class="label">{{ article.published_at | time_tag: format: 'date' }}</span>
            <span class="blog__title">{{ article.title }}</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
    {%- if paginate.pages > 1 -%}
      <nav class="pagination" aria-label="{{ 'general.pagination' | t }}">{{ paginate | default_pagination }}</nav>
    {%- endif -%}
  {%- endpaginate -%}
</section>

{% schema %}
{
  "name": "Blog",
  "tag": "div",
  "settings": []
}
{% endschema %}
