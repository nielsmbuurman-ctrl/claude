<section class="page-width list-collections">
  <h1 class="h1 page-title">{{ 'collections.all_title' | t }}</h1>
  <ul class="grid" role="list">
    {%- for c in collections -%}
      <li class="grid__item">
        <a class="collection-card" href="{{ c.url }}">
          <span class="collection-card__media">
            {%- if c.featured_image -%}
              {{ c.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '360, 540, 800', sizes: '(min-width: 990px) 25vw, 50vw', alt: c.title }}
            {%- else -%}
              {% render 'frame-sketch', label: c.title %}
            {%- endif -%}
          </span>
          <span class="card__title">{{ c.title }}</span>
        </a>
      </li>
    {%- endfor -%}
  </ul>
</section>

{% schema %}
{
  "name": "Collections list",
  "tag": "div",
  "settings": []
}
{% endschema %}
