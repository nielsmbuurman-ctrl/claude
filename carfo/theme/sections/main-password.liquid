<section class="password">
  <div class="password__inner">
    <p class="wordmark password__brand">{{ settings.wordmark | default: shop.name }}</p>
    <h1 class="display">{{ section.settings.heading }}</h1>
    <p>{{ section.settings.text }}</p>

    {%- form 'customer', id: 'WaitlistForm', class: 'password__form' -%}
      {%- if form.posted_successfully? -%}
        <p class="signup__success" role="status">{% render 'icon', name: 'check' %} {{ section.settings.success }}</p>
      {%- else -%}
        <input type="hidden" name="contact[tags]" value="waitlist,newsletter">
        <div class="inline-form">
          <label class="visually-hidden" for="WaitlistEmail">{{ 'newsletter.email' | t }}</label>
          <input id="WaitlistEmail" class="field" type="email" name="contact[email]" autocomplete="email" required placeholder="{{ 'newsletter.email' | t }}">
          <button class="btn" type="submit">{{ section.settings.button }}</button>
        </div>
        {%- if form.errors -%}<p class="form-error" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>{%- endif -%}
      {%- endif -%}
    {%- endform -%}

    <details class="password__login">
      <summary>{{ 'password.enter' | t }}</summary>
      {%- form 'storefront_password', class: 'inline-form' -%}
        <label class="visually-hidden" for="StorePassword">{{ 'password.password' | t }}</label>
        <input id="StorePassword" class="field" type="password" name="password" autocomplete="current-password" placeholder="{{ 'password.password' | t }}">
        <button class="btn btn--outline" type="submit">{{ 'password.submit' | t }}</button>
        {%- if form.errors -%}<p class="form-error" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
      {%- endform -%}
    </details>
  </div>
</section>

{% schema %}
{
  "name": "Waitlist",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Tien brillen. Binnenkort." },
    { "type": "text", "id": "text", "label": "Text", "default": "Zet je op de lijst en hoor als eerste wanneer Carfo opent." },
    { "type": "text", "id": "button", "label": "Button", "default": "Zet me op de lijst" },
    { "type": "text", "id": "success", "label": "Success message", "default": "Je staat op de lijst." }
  ]
}
{% endschema %}
