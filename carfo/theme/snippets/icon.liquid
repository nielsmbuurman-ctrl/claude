{%- comment -%}
  Thin line icons. Usage: render 'icon', name: 'bag'
{%- endcomment -%}
<svg class="icon icon--{{ name }}" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {%- case name -%}
    {%- when 'menu' -%}<path d="M3 7h18M3 12h18M3 17h18"/>
    {%- when 'close' -%}<path d="M6 6l12 12M18 6L6 18"/>
    {%- when 'search' -%}<circle cx="11" cy="11" r="6.5"/><path d="M16 16l4.5 4.5"/>
    {%- when 'account' -%}<circle cx="12" cy="8.5" r="3.75"/><path d="M4.5 20c1.4-3.6 4.2-5.25 7.5-5.25S18.1 16.4 19.5 20"/>
    {%- when 'bag' -%}<path d="M5 8h14l-1.2 12H6.2L5 8z"/><path d="M9 8V6.5a3 3 0 016 0V8"/>
    {%- when 'plus' -%}<path d="M12 5v14M5 12h14"/>
    {%- when 'minus' -%}<path d="M5 12h14"/>
    {%- when 'arrow' -%}<path d="M5 12h14M13 6l6 6-6 6"/>
    {%- when 'check' -%}<path d="M5 12.5l4.5 4.5L19 7.5"/>
    {%- when 'uv' -%}<circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"/>
    {%- when 'case' -%}<rect x="3" y="8" width="18" height="9" rx="4.5"/><path d="M3 12.5h18"/>
    {%- when 'truck' -%}<path d="M2.5 6.5h11v10h-11zM13.5 10h4l3 3.25v3.25h-7"/><circle cx="7" cy="17.5" r="1.75"/><circle cx="17" cy="17.5" r="1.75"/>
    {%- when 'return' -%}<path d="M9 7L4.5 11.5 9 16"/><path d="M5 11.5h9.5a5 5 0 010 10H12"/>
    {%- when 'ruler' -%}<rect x="2.5" y="8" width="19" height="8" rx="1"/><path d="M6.5 8v3M10 8v4M13.5 8v3M17 8v4"/>
    {%- when 'instagram' -%}<rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.25" cy="6.75" r=".6" fill="currentColor"/>
    {%- when 'tiktok' -%}<path d="M14 3.5v11.25a3.75 3.75 0 11-3.75-3.75"/><path d="M14 3.5c.5 2.6 2.4 4.4 5 4.6"/>
  {%- endcase -%}
</svg>
