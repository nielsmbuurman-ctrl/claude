# Copy to .env (git-ignored) for local use, or set these as environment
# variables in your Claude Code cloud environment settings.

# Your store's permanent domain (not your custom domain)
SHOPIFY_STORE=your-store.myshopify.com

# Theme editing: password from the free "Theme Access" app (starts with shptka_)
SHOPIFY_CLI_THEME_TOKEN=

# Admin API (products, pages, menus, metafields...): from your Dev Dashboard app
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Admin API version
SHOPIFY_API_VERSION=2026-10
